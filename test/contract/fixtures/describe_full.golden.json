          "type": "object",
          "required": [
            "ingredient_id",
            "rationale"
          ],
          "properties": {
            "uid": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,16}$"
            },
            "ingredient_id": {
              "type": "string"
            },
            "grams": {
              "type": "number",
              "minimum": 0
            },
            "bakers_pct": {
              "type": "number",
              "minimum": 0
            },
            "role": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      {
        "kind": "remove_ingredient",

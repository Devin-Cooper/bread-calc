{
  "name": "bread-calc",
  "version": "3.1.0",
  "description": "Hydration and loaf-weight calculator for the Zojirushi BB-PDC20 (and similar 2-lb bread machines), with an LLM-agent-friendly API.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/core/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./agent": {
      "types": "./dist/lib/agent/index.d.ts",
      "import": "./dist/lib/agent.js"
    },
    "./data": {
      "types": "./dist/lib/data/index.d.ts",
      "import": "./dist/lib/data/index.js"
    },
    "./schema": "./dist/lib/schema.json"
  },
  "bin": {
    "bread-calc": "dist/cli/bin.js"
  },
  "files": [
    "dist/lib",
    "dist/cli",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://breadmachine.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devin-Cooper/bread-calc.git"
  },
  "license": "MIT",
  "scripts": {
    "compile:validator": "node scripts/compile-validator.mjs",
    "transform:data": "node scripts/transform-data.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src test",
    "format": "prettier --write src test",
    "pretest": "npm run compile:validator && npm run build:lib && npm run transform:data && npm run build:cli && npm run build:examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-goldens": "UPDATE_GOLDENS=1 vitest run test/golden",
    "update-contract": "UPDATE_CONTRACT=1 vitest run test/contract",
    "build:examples": "node --experimental-strip-types scripts/build-examples.mjs",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:cli": "vite build --config vite.cli.config.ts && node scripts/add-shebang.mjs",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run compile:validator && npm run build:lib && npm run transform:data && npm run build:cli && npm run build:site",
    "dev": "vite --config vite.site.config.ts",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "ajv": "^8.17.0",
    "eslint": "^9.18.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.29.0",
    "fast-check": "^3.23.0",
    "happy-dom": "^16.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.0"
  }
}

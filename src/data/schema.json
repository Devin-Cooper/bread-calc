{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://breadmachine.io/schema/v2.0",
  "title": "bread-calc data schemas",
  "$defs": {
    "Category": {
      "type": "string",
      "enum": ["liquids", "sweeteners", "fats", "fresh_fruit", "dried_fruit", "nuts_seeds", "eggs",
               "cheese", "vegetables", "herbs_spices", "acids_alcohols", "specialty",
               "flour", "grain_cereal", "salt", "yeast", "leavener"]
    },
    "Role": {
      "type": "string",
      "enum": ["flour", "wet", "fat", "sweetener", "salt", "yeast", "leavener", "inclusion", "enrichment"]
    },
    "ZoneId": { "type": "string", "enum": ["dry", "sandwich", "wet", "very_wet"] },
    "IngredientFlag": {
      "type": "string",
      "enum": ["enzymatic_protease", "late_water_release", "humectant_bound_water",
               "alcohol_yeast_inhibitor", "high_salt", "acidic", "leavener_consumed",
               "gluten_strengthener", "gf_stabilizer"]
    },
    "Pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "Factor": { "type": "number", "minimum": 0, "maximum": 1 },
    "ForbiddenKeys": {
      "not": {
        "anyOf": [
          { "required": ["__proto__"] },
          { "required": ["constructor"] },
          { "required": ["prototype"] }
        ]
      }
    },
    "Ingredient": {
      "type": "object",
      "required": ["id", "name", "category", "is_liquid", "water_pct", "salt_pct", "sugar_pct",
                   "fat_pct", "free_water_factor", "density_g_per_cup"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/Category" },
        "is_liquid": { "type": "boolean" },
        "water_pct": { "$ref": "#/$defs/Pct" },
        "salt_pct": { "$ref": "#/$defs/Pct" },
        "sugar_pct": { "$ref": "#/$defs/Pct" },
        "fat_pct": { "$ref": "#/$defs/Pct" },
        "free_water_factor": { "$ref": "#/$defs/Factor" },
        "density_g_per_cup": { "type": ["number", "null"], "minimum": 0 },
        "protein_pct": { "$ref": "#/$defs/Pct" },
        "carb_pct": { "$ref": "#/$defs/Pct" },
        "alcohol_pct": { "$ref": "#/$defs/Pct" },
        "ash_pct": { "$ref": "#/$defs/Pct" },
        "ph": { "type": "number", "minimum": 0, "maximum": 14 },
        "notes": { "type": "string" },
        "usda_fdc_id": { "type": "integer", "minimum": 0 },
        "form_variants": { "type": "array", "items": { "type": "string" } },
        "flags": { "type": "array", "items": { "$ref": "#/$defs/IngredientFlag" }, "uniqueItems": true }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "IngredientsFile": {
      "type": "object",
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/Ingredient" } }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "Flour": {
      "type": "object",
      "required": ["id", "name", "category", "protein_pct", "ddt_water_absorption_pct", "density_g_per_cup"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string" },
        "category": { "const": "flour" },
        "protein_pct": { "$ref": "#/$defs/Pct" },
        "ddt_water_absorption_pct": { "$ref": "#/$defs/Pct" },
        "density_g_per_cup": { "type": "number", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "FloursFile": {
      "type": "object",
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/Flour" } }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20Recipe": {
      "type": "object",
      "required": ["name", "course", "total_water_g", "total_flour_g", "hydration_pct_nominal", "zone"],
      "properties": {
        "name": { "type": "string" },
        "course": { "type": "string" },
        "total_water_g": { "type": "number", "minimum": 0 },
        "total_flour_g": { "type": "number", "minimum": 0 },
        "hydration_pct_nominal": { "type": "number", "minimum": 0, "maximum": 200 },
        "zone": { "$ref": "#/$defs/ZoneId" },
        "excluded_from_chart": { "type": "boolean" }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20RecipesFile": {
      "type": "object",
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/BBPDC20Recipe" } }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20Stage": {
      "type": "object",
      "required": ["name", "duration_minutes", "target_temp_c"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["preheat", "knead_1", "rest", "knead_2",
                   "rise_1", "punch", "add_ins_beep", "rise_2",
                   "preheat_bake", "bake", "cool", "keep_warm"]
        },
        "duration_minutes": { "type": "number", "minimum": 0 },
        "target_temp_c": { "type": ["number", "null"] },
        "notes": { "type": "string" }
      },
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20Course": {
      "type": "object",
      "required": [
        "id", "course_number", "name",
        "total_minutes", "stages",
        "bakes", "loaf_sizes", "crust_shades",
        "inclusions_beep", "dietary_modes",
        "recommended_for", "yeast_compatibility",
        "confidence", "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "course_number": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "total_minutes": { "type": "number", "minimum": 0 },
        "stages": {
          "type": "array",
          "items": { "$ref": "#/$defs/BBPDC20Stage" }
        },
        "bakes": { "type": "boolean" },
        "loaf_sizes": {
          "type": "array",
          "items": { "type": "string", "enum": ["1lb", "1.5lb", "2lb"] },
          "uniqueItems": true
        },
        "crust_shades": {
          "type": "array",
          "items": { "type": "string", "enum": ["light", "medium", "dark"] },
          "uniqueItems": true
        },
        "inclusions_beep": { "type": "boolean" },
        "dietary_modes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["vegan", "salt_free", "sugar_free", "egg_free", "gluten_free"]
          },
          "uniqueItems": true
        },
        "recommended_for": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended_for_notes": { "type": "string" },
        "hydration_range": {
          "type": "object",
          "required": ["min_pct", "max_pct"],
          "additionalProperties": false,
          "properties": {
            "min_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "max_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "ideal_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "whole_wheat_max_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "yeast_compatibility": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["instant", "active_dry", "sourdough", "fresh"]
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "string",
          "enum": ["verified", "inferred", "community"]
        },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": { "type": "string" }
      },
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20CoursesFile": {
      "type": "object",
      "required": ["schema_version", "machine_id", "entries"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0" },
        "_attribution": { "type": "string" },
        "_methodology": { "type": "string" },
        "machine_id": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/BBPDC20Course" }
        }
      }
    },
    "BBPDC20TemplateItem": {
      "type": "object",
      "required": ["ingredient_id", "grams"],
      "additionalProperties": false,
      "properties": {
        "ingredient_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "grams": { "type": "number", "minimum": 0 }
      },
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20TemplateEntry": {
      "type": "object",
      "required": ["id", "name", "course", "items"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "course": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/BBPDC20TemplateItem" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "BBPDC20TemplatesFile": {
      "type": "object",
      "required": ["schema_version", "attribution", "entries"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "1.0" },
        "attribution": { "type": "string" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/BBPDC20TemplateEntry" }
        }
      }
    },
    "Defaults": {
      "type": "object",
      "required": ["default_free_water_factors_by_category", "default_bake_loss_pct", "default_machine_id"],
      "properties": {
        "default_free_water_factors_by_category": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Factor" }
        },
        "default_bake_loss_pct": { "$ref": "#/$defs/Pct" },
        "default_machine_id": { "type": "string" }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "Machine": {
      "type": "object",
      "required": ["id", "name", "pan_capacity_g", "pan_overflow_threshold_g",
                   "pan_underfill_threshold_g", "flour_quantity_typical_min_g",
                   "flour_quantity_typical_max_g", "inclusion_max_fraction_of_flour"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pan_capacity_g": { "type": "number", "minimum": 0 },
        "pan_overflow_threshold_g": { "type": "number", "minimum": 0 },
        "pan_underfill_threshold_g": { "type": "number", "minimum": 0 },
        "flour_quantity_typical_min_g": { "type": "number", "minimum": 0 },
        "flour_quantity_typical_max_g": { "type": "number", "minimum": 0 },
        "inclusion_max_fraction_of_flour": { "$ref": "#/$defs/Factor" }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "MachinesFile": {
      "type": "object",
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/Machine" } }
      },
      "additionalProperties": true,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "RecipeItem": {
      "type": "object",
      "required": ["uid", "ingredient_id"],
      "properties": {
        "uid": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,16}$" },
        "ingredient_id": { "type": "string" },
        "grams": { "type": "number", "minimum": 0 },
        "bakers_pct": { "type": "number", "minimum": 0 },
        "role": { "$ref": "#/$defs/Role" }
      },
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/ForbiddenKeys" }]
    },
    "Recipe": {
      "type": "object",
      "required": ["schema_version", "items"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "name": { "type": "string" },
        "notes": { "type": "string" },
        "machine": { "type": "string" },
        "target_loaf_g": { "type": "number", "minimum": 0 },
        "bake_loss_pct": { "$ref": "#/$defs/Pct" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/RecipeItem" }, "minItems": 1 },
        "free_water_factor_overrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Factor" }
        },
        "headline_metric": { "enum": ["effective", "nominal", "total_liquid"] },
        "course": { "type": "string" },
        "crust_shade": { "type": "string", "enum": ["light", "medium", "dark"] },
        "loaf_size": { "type": "string", "enum": ["1lb", "1.5lb", "2lb"] },
        "extended_notes": { "type": "string" },
        "bake_hints": { "type": "array", "items": { "type": "string" } },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dietary": { "type": "string", "enum": ["salt_free", "sugar_free", "vegan", "gluten_free"] },
            "time": { "type": "string", "enum": ["rapid"] },
            "output": { "type": "string", "enum": ["bake", "dough"] }
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        { "$ref": "#/$defs/ForbiddenKeys" },
        {
          "if": { "required": ["target_loaf_g"] },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "anyOf": [
                    { "required": ["grams"] },
                    { "required": ["bakers_pct"] }
                  ]
                }
              }
            }
          }
        }
      ]
    }
    ,
    "BBPDC20RecipeMatrix": {
      "type": "object",
      "required": ["schema_version", "entries"],
      "additionalProperties": true,
      "properties": {
        "schema_version": { "type": "string" },
        "_attribution": { "type": "string" },
        "_methodology": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "canonical_course", "canonical_family", "recipe"],
            "properties": {
              "name": { "type": "string" },
              "canonical_course": { "type": "string" },
              "canonical_family": { "type": "array", "items": { "type": "string" } },
              "recipe": { "$ref": "#/$defs/Recipe" }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/Recipe" },
    { "$ref": "#/$defs/IngredientsFile" },
    { "$ref": "#/$defs/FloursFile" },
    { "$ref": "#/$defs/BBPDC20RecipesFile" },
    { "$ref": "#/$defs/BBPDC20TemplatesFile" },
    { "$ref": "#/$defs/MachinesFile" },
    { "$ref": "#/$defs/Defaults" },
    { "$ref": "#/$defs/BBPDC20CoursesFile" },
    { "$ref": "#/$defs/BBPDC20RecipeMatrix" }
  ]
}
